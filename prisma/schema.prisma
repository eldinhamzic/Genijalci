generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  PARENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEFT
}

model User {
  id           String      @id @default(cuid())
  role         Role
  name         String
  email        String      @unique
  passwordHash String
  parent       Parent?
  sentMessages Message[]   @relation("sent")
  recvMessages Message[]   @relation("received")
  audits       AuditLog[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Child {
  id          String       @id @default(cuid())
  name        String
  grade       Int
  school      String
  notes       String?
  groupId     String
  parents     ChildParent[]
  attendance  Attendance[]
  homework    Homework[]
}

model Parent {
  id          String       @id @default(cuid())
  userId      String       @unique
  phone       String
  pickups     String[]
  user        User         @relation(fields: [userId], references: [id])
  children    ChildParent[]
}

model ChildParent {
  childId     String
  parentId    String
  child       Child        @relation(fields: [childId], references: [id])
  parent      Parent       @relation(fields: [parentId], references: [id])

  @@id([childId, parentId])
}

model Attendance {
  id           String            @id @default(cuid())
  childId       String
  date          DateTime
  checkInTime   DateTime?
  checkOutTime  DateTime?
  status        AttendanceStatus
  child         Child             @relation(fields: [childId], references: [id])

  @@unique([childId, date])
}

model Homework {
  id           String    @id @default(cuid())
  childId      String
  description  String
  completed    Boolean   @default(false)
  date         DateTime
  child        Child     @relation(fields: [childId], references: [id])
}

model Menu {
  id              String   @id @default(cuid())
  date            DateTime @unique
  mealDescription String
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  timestamp  DateTime @default(now())
  sender     User     @relation("sent", fields: [senderId], references: [id])
  receiver   User     @relation("received", fields: [receiverId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  payload   Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}
